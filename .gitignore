# Secrets and local env — never commit
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!**/.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
.next/
dist/

# Runtime data / dumps (recreated locally).
data/volumes/
data/backups/
data/cache/
data/cnn_synth/
data/processed/*.db
data/processed/*.db-*
data/processed/*.json
data/raw/*
!data/raw/.gitkeep

# SQLite anywhere — except the observatory snapshot Mac/Windows share.
*.sqlite
*.db
*.db-wal
*.db-shm
!data/processed/tnb.db

# Media / training dumps (track a small thumb set; skip cnn_synth)
storage/images/*
!storage/images/.gitkeep
!storage/images/*.png
!storage/images/*.jpg
!storage/images/*.jpeg
!storage/images/*.svg
!storage/images/*.webp
!storage/images/*.gif
models/cnn/dataset/**/*.jpg
models/cnn/dataset/**/*.jpeg
models/cnn/dataset/**/*.png
models/cnn/dataset/**/*.webp
models/cnn/dataset/**/*.bmp
!models/cnn/dataset/**/.gitkeep

# Logs / OS / zip copies
*.log
logs/
.DS_Store
Thumbs.db
*.zip
mac.zip
