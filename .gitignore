# Secrets and local env — never commit
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!**/.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
.next/
dist/

# Runtime data / dumps (recreated locally).
data/volumes/
data/backups/
data/cache/
data/cnn_synth/
data/processed/*.db
data/processed/*.db-*
data/processed/*.json
data/raw/*
!data/raw/.gitkeep

# SQLite anywhere — except the observatory snapshot Mac/Windows share.
*.sqlite
*.db
*.db-wal
*.db-shm
!data/processed/tnb.db

# Runtime dumps. Keep the folder; do not commit mined photos.
storage/images/*
!storage/images/.gitkeep
models/cnn/dataset/**/*.jpg
models/cnn/dataset/**/*.jpeg
models/cnn/dataset/**/*.png
models/cnn/dataset/**/*.webp
models/cnn/dataset/**/*.bmp
models/cnn/dataset/**/*.gif
!models/cnn/dataset/**/.gitkeep

# Licencias vendidas (archivo local; no subir)
license.key
data/license.key
data/accounts.sqlite
data/accounts.sqlite-*

# Logs / OS / zip copies
*.log
logs/
.DS_Store
Thumbs.db
*.zip
mac.zip
.cursor/
