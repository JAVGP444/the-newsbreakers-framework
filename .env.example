# The NewsBreakers — framework (sin secretos)
# Proyecto vigente: C:\Users\javie\OneDrive\Escritorio\Generador_Excel_Enfermedades
# Esta carpeta:     C:\Users\javie\OneDrive\Escritorio\the-newsbreakers-framework
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8010

# Auth opcional. Si se define, POST /cycle, /cnn/predict y /alerts/{id}/review
# exigen cabecera X-API-Token. El dashboard Vite usa VITE_API_TOKEN.
# TNB_API_TOKEN=
# VITE_API_TOKEN=

POSTGRES_URL=postgresql://tnb:tnb@localhost:5432/tnb
MONGO_URL=mongodb://localhost:27017
MONGO_DB=tnb_raw
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_DIR=./storage/images

# MySQL warehouse (docker compose up -d mysql). Sin secretos reales.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tnb
MYSQL_PASSWORD=tnb
MYSQL_DATABASE=newsbreakers
# Si 3306 ya está ocupado: MYSQL_PORT=3307 y MYSQL_PUBLISH_PORT=3307
# MYSQL_PUBLISH_PORT=3306
TNB_MINE_INTERVAL_MINUTES=30
TNB_CNN_DATASET_MIN_CONF=0.5

# Tope por ciclo. 0 en tests = no fetch. En Mac/Windows default alto = toda la watchlist.
TNB_MAX_SOURCES=250
TNB_RSS_LIMIT=100
TNB_RSS_PAGES=3
TNB_GDELT_MAX=75
TNB_GDELT_WINDOWS=4
TNB_GDELT_LOOKBACK_DAYS=21
TNB_HTML_FETCH_PER_SOURCE=8
TNB_HTML_LISTINGS=1
TNB_HTML_LISTING_SOURCES=10
# TNB_CORPUS_NEWS_LIMIT=200
# TNB_FORCE_DUE=1
# TNB_VERBOSE_SKIPS=1

# Minería real: sin semilla demo ni delays recortados.
TNB_DEMO_SEED=0
TNB_FAST=0

# Observatorio Excel / imágenes (carpeta hermana, opcional).
# Windows (ejemplo local): TNB_DEMO_ROOT=C:\Users\javie\OneDrive\Escritorio\Generador_Excel_Enfermedades
# Mac: deja vacío o apunta a ~/Desktop/Generador_Excel_Enfermedades si la copiaste.
# Sin esta carpeta el observatorio Vite (puerto 5173) abre igual.
# TNB_DEMO_ROOT=

# Opcional: OCR del Document Intelligence Studio
# TNB_OCR_SRC=
