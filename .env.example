# The NewsBreakers — sin secretos
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8010

# Token opcional para POST /cycle y /cnn/predict
# TNB_API_TOKEN=
# VITE_API_TOKEN=

# Casa escribible del .exe (Windows usa %APPDATA%\TheNewsBreakers si no pones nada).
# TNB_HOME=

# Claves de APIs de pago: las pone el cliente. No se comparten en el zip/git.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# OLLAMA_MODEL=llama3

POSTGRES_URL=postgresql://tnb:tnb@localhost:5432/tnb
MONGO_URL=mongodb://localhost:27017
MONGO_DB=tnb_raw
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_DIR=./storage/images

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tnb
MYSQL_PASSWORD=tnb
MYSQL_DATABASE=newsbreakers

TNB_MINE_INTERVAL_MINUTES=30
TNB_CNN_DATASET_MIN_CONF=0.5
TNB_MAX_SOURCES=250
TNB_RSS_LIMIT=100
TNB_RSS_PAGES=3
TNB_GDELT_MAX=75
TNB_GDELT_WINDOWS=4
TNB_GDELT_LOOKBACK_DAYS=21
TNB_HTML_FETCH_PER_SOURCE=8
TNB_HTML_LISTINGS=1
TNB_HTML_LISTING_SOURCES=10
TNB_DEMO_SEED=0
TNB_FAST=0
TNB_MYSQL=0

# Carpeta Excel hermana. Opcional; el observatorio abre sin ella.
# TNB_DEMO_ROOT=

# OCR Studio (opcional)
# TNB_OCR_SRC=
